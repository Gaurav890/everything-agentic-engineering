{
  "theme": {
    "light": {
      "color": {
        "background": {
          "canvas": {"$type": "color", "$value": "{color.neutral.0}"},
          "surface": {"$type": "color", "$value": "{color.neutral.50}"}
        },
        "text": {
          "primary": {"$type": "color", "$value": "{color.neutral.950}"},
          "secondary": {"$type": "color", "$value": "{color.neutral.600}"}
        },
        "border": {"default": {"$type": "color", "$value": "{color.neutral.200}"}},
        "action": {
          "primary": {
            "default": {"$type": "color", "$value": "{color.accent.600}"},
            "hover": {"$type": "color", "$value": "{color.accent.700}"},
            "pressed": {"$type": "color", "$value": "{color.accent.800}"},
            "foreground": {"$type": "color", "$value": "{color.neutral.0}"}
          }
        },
        "focus": {"ring": {"$type": "color", "$value": "{color.accent.600}"}},
        "feedback": {
          "success": {"$type": "color", "$value": "{color.green.600}"},
          "warning": {"$type": "color", "$value": "{color.amber.600}"},
          "danger": {"$type": "color", "$value": "{color.red.600}"},
          "info": {"$type": "color", "$value": "{color.blue.600}"}
        },
        "agent": {
          "idle": {"$type": "color", "$value": "{color.neutral.600}"},
          "thinking": {"$type": "color", "$value": "{color.blue.600}"},
          "running": {"$type": "color", "$value": "{color.accent.600}"},
          "approval": {"$type": "color", "$value": "{color.amber.600}"},
          "complete": {"$type": "color", "$value": "{color.green.600}"},
          "failed": {"$type": "color", "$value": "{color.red.600}"}
        }
      }
    }
  }
}
