{
  "theme": {
    "dark": {
      "color": {
        "background": {
          "canvas": {"$type": "color", "$value": "{color.neutral.950}"},
          "surface": {"$type": "color", "$value": "{color.neutral.900}"}
        },
        "text": {
          "primary": {"$type": "color", "$value": "{color.neutral.0}"},
          "secondary": {"$type": "color", "$value": "{color.neutral.200}"}
        },
        "border": {"default": {"$type": "color", "$value": "{color.neutral.600}"}},
        "action": {"primary": {"$type": "color", "$value": "{color.accent.400}"}},
        "feedback": {
          "success": {"$type": "color", "$value": "{color.green.600}"},
          "warning": {"$type": "color", "$value": "{color.amber.600}"},
          "danger": {"$type": "color", "$value": "{color.red.600}"},
          "info": {"$type": "color", "$value": "{color.blue.600}"}
        },
        "agent": {
          "idle": {"$type": "color", "$value": "{color.neutral.200}"},
          "thinking": {"$type": "color", "$value": "{color.blue.600}"},
          "running": {"$type": "color", "$value": "{color.accent.400}"},
          "approval": {"$type": "color", "$value": "{color.amber.600}"},
          "complete": {"$type": "color", "$value": "{color.green.600}"},
          "failed": {"$type": "color", "$value": "{color.red.600}"}
        }
      }
    }
  }
}
