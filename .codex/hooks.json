{
  "description": "Project safety hooks shared with the Claude adapter. Review and trust these hooks in Codex before enabling them.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/pre-tool-security.sh\"",
            "statusMessage": "Checking destructive command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/post-edit-secret-scan.sh\"",
            "statusMessage": "Checking edited files for likely secrets"
          }
        ]
      }
    ]
  }
}
