{
  "name": "@everything-agentic/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "python3 ../../scripts/build_design_tokens.py",
    "dev": "next dev",
    "prebuild": "python3 ../../scripts/build_design_tokens.py",
    "build": "next build",
    "prelint": "next typegen",
    "lint": "tsc --noEmit",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "@everything-agentic/api": "workspace:*",
    "@everything-agentic/database": "workspace:*",
    "@everything-agentic/domain": "workspace:*",
    "@everything-agentic/types": "workspace:*",
    "@everything-agentic/ui": "workspace:*",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
