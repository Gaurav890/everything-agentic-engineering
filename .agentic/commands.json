{
  "schema_version": 1,
  "name": "Everything Agentic Engineering command registry",
  "entrypoint": "./agentic",
  "groups": [
    {"name": "setup", "summary": "Initialize the starter and optional external skills"},
    {"name": "profile", "summary": "Inspect and select project capability profiles"},
    {"name": "task", "summary": "Plan, start, verify, synchronize, and close tasks"},
    {"name": "pr", "summary": "Prepare and finalize pull requests"},
    {"name": "workspace", "summary": "Create isolated branches and worktrees"},
    {"name": "doctor", "summary": "Check runtime and integration health"},
    {"name": "tokens", "summary": "Build and validate design-token outputs"},
    {"name": "release", "summary": "Validate release readiness"}
  ],
  "commands": [
    {"path": ["agents"], "target": "scripts/agent-broker.sh", "summary": "Discover, route, activate, and validate reviewed specialist contracts", "usage": "./agentic agents <list|show|recommend|activate|deactivate|doctor> [arguments]", "impact": "read_only_or_confirmed_manifest_write"},
    {"path": ["capabilities"], "target": "scripts/capabilities.sh", "summary": "Explain built-in, recommended, optional, missing, and blocked capabilities", "usage": "./agentic capabilities <list|show|plan|doctor> [arguments]", "impact": "read_only"},
    {"path": ["setup", "bootstrap"], "target": "scripts/bootstrap.sh", "summary": "Validate prerequisites and prepare a local checkout", "usage": "./agentic setup bootstrap", "impact": "local_write"},
    {"path": ["setup", "init"], "target": "scripts/init-project.sh", "summary": "Configure a project from an approved starter preset", "usage": "./agentic setup init [initializer options]", "impact": "local_write"},
    {"path": ["setup", "skills"], "target": "scripts/install-skills.sh", "summary": "Install reviewed external skills required by active profiles", "usage": "./agentic setup skills [--dry-run]", "impact": "external_install"},
    {"path": ["profile", "resolve"], "target": "scripts/profile-resolve.sh", "summary": "Resolve the active profile manifest", "usage": "./agentic profile resolve", "impact": "read_only"},
    {"path": ["profile", "doctor"], "target": "scripts/profile-doctor.sh", "summary": "Report profile drift without installing or removing resources", "usage": "./agentic profile doctor", "impact": "read_only"},
    {"path": ["profile", "preview"], "target": "scripts/profile-preview.sh", "summary": "Preview a profile selection before applying it", "usage": "./agentic profile preview <comma-separated-profiles>", "impact": "read_only"},
    {"path": ["profile", "select"], "target": "scripts/profile-select.sh", "summary": "Apply an explicitly selected project profile set", "usage": "./agentic profile select <comma-separated-profiles> [--yes]", "impact": "local_write"},
    {"path": ["task", "plan"], "target": "scripts/task-plan.sh", "summary": "Show task dependencies, ownership, routing, and verification", "usage": "./agentic task plan <TASK-ID> [--json]", "impact": "read_only"},
    {"path": ["task", "start"], "target": "scripts/task-start.sh", "summary": "Start an approved task in a branch or isolated worktree", "usage": "./agentic task start <TASK-ID> [launcher options]", "impact": "git_write"},
    {"path": ["task", "sync"], "target": "scripts/task-sync.sh", "summary": "Validate the task, issue, and pull-request contract", "usage": "./agentic task sync <operation> [args]", "impact": "read_only"},
    {"path": ["task", "finish"], "target": "scripts/finish-task.sh", "summary": "Run full verification and move a task to human review", "usage": "./agentic task finish <TASK-ID>", "impact": "local_write"},
    {"path": ["task", "closeout"], "target": "scripts/task-closeout.sh", "summary": "Inspect authoritative post-merge state and cleanup guidance", "usage": "./agentic task closeout <TASK-ID>", "impact": "read_only"},
    {"path": ["pr", "ready"], "target": "scripts/pr-ready.sh", "summary": "Verify branch and task readiness before requesting review", "usage": "./agentic pr ready <TASK-ID>", "impact": "read_only"},
    {"path": ["pr", "finalize"], "target": "scripts/finalize-pr.sh", "summary": "After direct human approval, prepare a PR for merge", "usage": "./agentic pr finalize <TASK-ID> [--dry-run|--yes]", "impact": "git_and_github_write"},
    {"path": ["workspace", "branch"], "target": "scripts/new-branch.sh", "summary": "Create a policy-compliant short-lived branch", "usage": "./agentic workspace branch <type> <TASK-ID> <slug> [base]", "impact": "git_write"},
    {"path": ["workspace", "worktree"], "target": "scripts/create-worktree.sh", "summary": "Create an isolated task worktree", "usage": "./agentic workspace worktree <TASK-ID> <slug> [type] [base]", "impact": "git_write"},
    {"path": ["doctor", "mcp"], "target": "scripts/mcp-doctor.sh", "summary": "Check MCP configuration without revealing secret values", "usage": "./agentic doctor mcp", "impact": "read_only"},
    {"path": ["doctor", "plugin"], "target": "scripts/agent-plugin-doctor.sh", "summary": "Validate the Agent Plugins 1.0 portable package contract", "usage": "./agentic doctor plugin [--json]", "impact": "read_only"},
    {"path": ["doctor", "runtime"], "target": "scripts/runtime-doctor.sh", "summary": "Report Claude Code and Codex runtime compatibility", "usage": "./agentic doctor runtime [runtime options]", "impact": "read_only"},
    {"path": ["doctor", "codex"], "target": "scripts/codex-doctor.sh", "summary": "Validate the Codex adapter and safety contract", "usage": "./agentic doctor codex [--strict-runtime]", "impact": "read_only"},
    {"path": ["verify"], "target": "scripts/verify.sh", "summary": "Run repository verification", "usage": "./agentic verify [quick|full]", "impact": "local_build"},
    {"path": ["tokens", "build"], "target": "scripts/build-design-tokens.sh", "summary": "Generate or check design-token outputs", "usage": "./agentic tokens build [--check]", "impact": "local_build"},
    {"path": ["release", "check"], "target": "scripts/release-check.sh", "summary": "Validate the release contract for a semantic tag", "usage": "./agentic release check [tag]", "impact": "read_only"},
    {"path": ["release", "smoke"], "target": "scripts/release-smoke-test.sh", "summary": "Exercise onboarding in a disposable clean checkout", "usage": "./agentic release smoke", "impact": "temporary_write"}
  ],
  "shell_inventory": [
    {"path": ".claude/hooks/post-edit-secret-scan.sh", "classification": "security_hook", "reason": "Runtime safety hook; never a contributor command"},
    {"path": ".claude/hooks/pre-tool-security.sh", "classification": "security_hook", "reason": "Runtime safety hook; never a contributor command"},
    {"path": "scripts/agent-broker.sh", "classification": "public", "canonical_command": "agents"},
    {"path": "scripts/agent-plugin-doctor.sh", "classification": "public", "canonical_command": "doctor plugin"},
    {"path": "scripts/bootstrap.sh", "classification": "public", "canonical_command": "setup bootstrap"},
    {"path": "scripts/build-design-tokens.sh", "classification": "public", "canonical_command": "tokens build"},
    {"path": "scripts/capabilities.sh", "classification": "public", "canonical_command": "capabilities"},
    {"path": "scripts/check-branch-name.sh", "classification": "internal", "reason": "Policy helper invoked by CI and higher-level workflows"},
    {"path": "scripts/check-pr-task-state.sh", "classification": "internal", "reason": "Policy helper invoked by CI"},
    {"path": "scripts/check-pr-title.sh", "classification": "internal", "reason": "Policy helper invoked by CI"},
    {"path": "scripts/codex-doctor.sh", "classification": "public", "canonical_command": "doctor codex"},
    {"path": "scripts/create-worktree.sh", "classification": "public", "canonical_command": "workspace worktree"},
    {"path": "scripts/finalize-pr.sh", "classification": "public", "canonical_command": "pr finalize"},
    {"path": "scripts/finish-task.sh", "classification": "public", "canonical_command": "task finish"},
    {"path": "scripts/init-project.sh", "classification": "public", "canonical_command": "setup init"},
    {"path": "scripts/install-skills.sh", "classification": "public", "canonical_command": "setup skills"},
    {"path": "scripts/mcp-doctor.sh", "classification": "public", "canonical_command": "doctor mcp"},
    {"path": "scripts/new-branch.sh", "classification": "public", "canonical_command": "workspace branch"},
    {"path": "scripts/pr-ready.sh", "classification": "public", "canonical_command": "pr ready"},
    {"path": "scripts/prepare-merge.sh", "classification": "internal", "reason": "Low-level ledger transition used by the bounded PR finalizer"},
    {"path": "scripts/profile-doctor.sh", "classification": "public", "canonical_command": "profile doctor"},
    {"path": "scripts/profile-preview.sh", "classification": "public", "canonical_command": "profile preview"},
    {"path": "scripts/profile-resolve.sh", "classification": "public", "canonical_command": "profile resolve"},
    {"path": "scripts/profile-select.sh", "classification": "public", "canonical_command": "profile select"},
    {"path": "scripts/release-check.sh", "classification": "public", "canonical_command": "release check"},
    {"path": "scripts/release-smoke-test.sh", "classification": "public", "canonical_command": "release smoke"},
    {"path": "scripts/runtime-doctor.sh", "classification": "public", "canonical_command": "doctor runtime"},
    {"path": "scripts/start-task.sh", "classification": "compatibility", "replacement": "task start", "reason": "Legacy status-only helper retained for existing callers"},
    {"path": "scripts/task-closeout.sh", "classification": "public", "canonical_command": "task closeout"},
    {"path": "scripts/task-plan.sh", "classification": "public", "canonical_command": "task plan"},
    {"path": "scripts/task-start.sh", "classification": "public", "canonical_command": "task start"},
    {"path": "scripts/task-sync.sh", "classification": "public", "canonical_command": "task sync"},
    {"path": "scripts/verify.sh", "classification": "public", "canonical_command": "verify"}
  ]
}
