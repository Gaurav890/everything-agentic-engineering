{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everything-agentic-engineering.dev/schemas/evolution-evaluation-result.json",
  "title": "Harness evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "harness_id", "policy_sha256", "eval_set_sha256", "builder_role", "evaluator_role", "changed_paths", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "harness_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "eval_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "builder_role": {"type": "string", "minLength": 1},
    "evaluator_role": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "quality_score", "safety_pass", "cost_units", "latency_ms"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"},
          "quality_score": {"type": "number", "minimum": 0, "maximum": 1},
          "safety_pass": {"type": "boolean"},
          "cost_units": {"type": "number", "minimum": 0},
          "latency_ms": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
