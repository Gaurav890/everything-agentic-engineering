{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:everything-agentic-engineering:schema:action-registry:1.0.0",
  "title": "No-shell supervised-run action registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "actions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "pattern": "^registry_[a-z0-9][a-z0-9_-]{7,63}$"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "executable", "argv", "cwd", "environment", "timeout_seconds", "shell", "network", "authority"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
          "executable": {"type": "string", "pattern": "^(?:/|\\./)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
          "argv": {"type": "array", "items": {"type": "string", "pattern": "^[^\\u0000\\r\\n]*$"}},
          "cwd": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope", "relative"],
            "properties": {
              "scope": {"const": "worktree"},
              "relative": {"type": "string", "pattern": "^(?:\\.|(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+)$"}
            }
          },
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "allow"],
            "properties": {
              "mode": {"const": "closed"},
              "allow": {"type": "array", "items": {"enum": ["CI", "TERM", "NO_COLOR"]}, "uniqueItems": true}
            }
          },
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
          "shell": {"const": false},
          "network": {"const": "disabled"},
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "deploy", "merge", "approve", "release", "write_default_branch", "sandbox_bypass", "expand_network"],
            "properties": {
              "class": {"enum": ["read_only", "workspace_check"]},
              "deploy": {"const": false},
              "merge": {"const": false},
              "approve": {"const": false},
              "release": {"const": false},
              "write_default_branch": {"const": false},
              "sandbox_bypass": {"const": false},
              "expand_network": {"const": false}
            }
          }
        }
      }
    }
  },
  "x-semantic-rules": [
    "action ids are unique",
    "the registry digest is bound into every plan and adapter request",
    "executables and argv are passed directly without a command shell",
    "cwd resolves beneath the canonical task worktree without symlink escape",
    "unknown actions and any authority-expanding metadata fail closed"
  ]
}
