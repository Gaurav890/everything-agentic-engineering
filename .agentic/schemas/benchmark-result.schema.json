{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:everything-agentic-engineering:schema:benchmark-arm-result:1.0.0",
  "title": "Blind product-to-proof benchmark arm result",
  "description": "One arm run for one brief and repetition, reidentified only after blind reviewer records are sealed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "protocol_sha256", "brief_id", "brief_sha256", "acceptance_sha256", "repetition", "blind_arm_id", "workflow_label", "reidentified_at", "arm_position", "operator_id", "builder_ids", "operator_protocol_sha256", "pinned_setup", "reviewers", "aggregate_scores", "measurements", "counts", "violations", "failures", "exclusions", "artifacts", "failures_published", "verdict"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "benchmark_id": {"type": "string", "pattern": "^bench_[a-z0-9][a-z0-9_-]{7,63}$"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "brief_id": {"type": "string", "minLength": 1},
    "brief_sha256": {"$ref": "#/$defs/sha256"},
    "acceptance_sha256": {"$ref": "#/$defs/sha256"},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 4},
    "blind_arm_id": {"type": "string", "pattern": "^arm_[a-z0-9][a-z0-9_-]{7,63}$"},
    "workflow_label": {"type": "string", "minLength": 1},
    "reidentified_at": {"type": "string", "format": "date-time"},
    "arm_position": {"type": "integer", "minimum": 1},
    "operator_id": {"type": "string", "minLength": 1},
    "builder_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "operator_protocol_sha256": {"$ref": "#/$defs/sha256"},
    "pinned_setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit", "workflow_version", "provider", "provider_version", "model", "machine", "dependency_state", "cache_state", "network_policy_sha256", "permission_policy_sha256"],
      "properties": {
        "repository_commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
        "workflow_version": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "dependency_state": {"type": "string", "minLength": 1},
        "cache_state": {"enum": ["cold", "warm", "mixed"]},
        "network_policy_sha256": {"$ref": "#/$defs/sha256"},
        "permission_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "blind", "independent_from_builder", "sealed_at", "scores"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "blind": {"const": true},
          "independent_from_builder": {"const": true},
          "sealed_at": {"type": "string", "format": "date-time"},
          "scores": {"$ref": "#/$defs/scores"}
        }
      }
    },
    "aggregate_scores": {"$ref": "#/$defs/scores"},
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_minutes", "wall_minutes", "human_intervention_minutes", "cost"],
      "properties": {
        "active_minutes": {"$ref": "#/$defs/measurement"},
        "wall_minutes": {"$ref": "#/$defs/measurement"},
        "human_intervention_minutes": {"$ref": "#/$defs/measurement"},
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "currency", "estimated", "unknown_reason"],
          "properties": {
            "value": {"type": ["number", "null"], "minimum": 0},
            "currency": {"enum": ["USD", "unknown"]},
            "estimated": {"type": "boolean"},
            "unknown_reason": {"type": ["string", "null"], "minLength": 1}
          },
          "oneOf": [
            {"properties": {"value": {"type": "number"}, "unknown_reason": {"type": "null"}}},
            {"properties": {"value": {"type": "null"}, "currency": {"const": "unknown"}, "unknown_reason": {"type": "string"}}}
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "waves", "retries", "failure_fingerprints", "checks", "evidence_items", "human_decisions"],
      "properties": {
        "tasks": {"type": "integer", "minimum": 0},
        "waves": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "failure_fingerprints": {"type": "integer", "minimum": 0},
        "checks": {"type": "integer", "minimum": 0},
        "evidence_items": {"type": "integer", "minimum": 0},
        "human_decisions": {"type": "integer", "minimum": 0}
      }
    },
    "violations": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "exclusions": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"enum": ["product", "source", "test", "visual", "accessibility", "performance", "recovery", "review", "log"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "failures_published": {"const": true},
    "verdict": {"enum": ["pass", "fail", "insufficient_evidence"]}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "pass"}}},
      "then": {
        "properties": {
          "violations": {"maxItems": 0},
          "exclusions": {"maxItems": 0},
          "measurements": {
            "properties": {
              "active_minutes": {"properties": {"value": {"type": "number"}, "unknown_reason": {"type": "null"}}},
              "wall_minutes": {"properties": {"value": {"type": "number"}, "unknown_reason": {"type": "null"}}},
              "human_intervention_minutes": {"properties": {"value": {"type": "number"}, "unknown_reason": {"type": "null"}}},
              "cost": {"properties": {"value": {"type": "number"}, "currency": {"const": "USD"}, "unknown_reason": {"type": "null"}}}
            }
          },
          "counts": {"properties": {"checks": {"minimum": 1}, "evidence_items": {"minimum": 1}}}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "score": {"type": "number", "minimum": 0, "maximum": 5},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness", "design_specificity", "interaction_quality", "accessibility", "recovery"],
      "properties": {
        "correctness": {"$ref": "#/$defs/score"},
        "design_specificity": {"$ref": "#/$defs/score"},
        "interaction_quality": {"$ref": "#/$defs/score"},
        "accessibility": {"$ref": "#/$defs/score"},
        "recovery": {"$ref": "#/$defs/score"}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unknown_reason"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0},
        "unknown_reason": {"type": ["string", "null"], "minLength": 1}
      },
      "oneOf": [
        {"properties": {"value": {"type": "number"}, "unknown_reason": {"type": "null"}}},
        {"properties": {"value": {"type": "null"}, "unknown_reason": {"type": "string"}}}
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary", "blocking", "artifact_sha256"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "x-semantic-rules": [
    "reviewer ids are unique and differ from every builder/operator id",
    "aggregate scores equal the pre-registered mean of two sealed reviewer scores or median of three after disagreement",
    "workflow_label is added only after every blind reviewer record is sealed",
    "blocking violations force fail and missing required measurements force insufficient_evidence",
    "artifact and publication records resolve and match their digests"
  ]
}
