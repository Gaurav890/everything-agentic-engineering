      "cwd": {"scope": "worktree", "relative": "."},
      "environment": {"mode": "closed", "allow": ["CI", "TERM", "NO_COLOR"]},
      "timeout_seconds": 1800,
      "shell": false,
      "network": "disabled",
      "authority": {"class": "workspace_check", "deploy": false, "merge": false, "approve": false, "release": false, "write_default_branch": false, "sandbox_bypass": false, "expand_network": false}
    },
    {
      "id": "verify.visual",
      "executable": "./agentic",
      "argv": ["verify", "visual"],
      "cwd": {"scope": "worktree", "relative": "."},
      "environment": {"mode": "closed", "allow": ["CI", "TERM", "NO_COLOR"]},
      "timeout_seconds": 3600,
      "shell": false,
      "network": "disabled",
      "authority": {"class": "workspace_check", "deploy": false, "merge": false, "approve": false, "release": false, "write_default_branch": false, "sandbox_bypass": false, "expand_network": false}
    },
    {
      "id": "verify.web",
      "executable": "./agentic",
      "argv": ["verify", "web"],
      "cwd": {"scope": "worktree", "relative": "."},
      "environment": {"mode": "closed", "allow": ["CI", "TERM", "NO_COLOR"]},
      "timeout_seconds": 3600,
      "shell": false,
      "network": "disabled",
      "authority": {"class": "workspace_check", "deploy": false, "merge": false, "approve": false, "release": false, "write_default_branch": false, "sandbox_bypass": false, "expand_network": false}
    }
  ]
}
