{
  "schema_version": 1,
  "source_roots": [
    ".agentic",
    ".agents",
    ".claude",
    ".codex",
    ".github",
    "apps",
    "docs",
    "packages",
    "scripts",
    "skills",
    ".gitignore",
    "AGENTS.md",
    "CLAUDE.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md",
    "agentic",
    "pnpm-workspace.yaml"
  ],
  "always_excluded": [
    ".agentic/project.json",
    ".claude/settings.local.json",
    ".claude/worktrees",
    ".github/workflows/release.yml",
    ".github/workflows/showcase.yml",
    "apps/showcase",
    "docs/50-evals/evidence",
    "docs/80-showcase",
    "docs/assets",
    "docs/releases",
    "packages/design-tokens/generated"
  ],
  "profile_paths": {
    "apps/web": ["web-next"],
    ".github/workflows/web-quality.yml": ["web-next"],
    "apps/mobile": ["mobile-expo"],
    "packages/ui": ["web-next"],
    "packages/api": ["backend-supabase", "backend-convex"],
    "packages/database": ["backend-supabase", "backend-convex"],
    "packages/domain": ["web-next", "mobile-expo", "backend-supabase", "backend-convex"],
    "packages/types": ["web-next", "mobile-expo", "backend-supabase", "backend-convex"],
    "packages/config": ["web-next", "mobile-expo", "backend-supabase", "backend-convex"],
    "packages/design-tokens": ["design-critical"],
    ".agentic/design.json": ["design-critical"],
    ".agentic/design-intake.json": ["design-critical"],
    ".agentic/design-directions.json": ["design-critical"],
    ".claude/agents/frontend.md": ["web-next"],
    ".claude/rules/frontend.md": ["web-next"],
    ".claude/agents/mobile.md": ["mobile-expo"],
    ".claude/rules/mobile.md": ["mobile-expo"],
    ".claude/agents/backend.md": ["backend-supabase", "backend-convex"],
    ".claude/rules/backend.md": ["backend-supabase", "backend-convex"],
    ".claude/agents/researcher.md": ["research-enabled"],
    ".claude/rules/research.md": ["research-enabled"]
  }
}
